/* ============================================================
   pages/index/index.wxss
   所有颜色都来自父级的 CSS 变量（由校徽色算出来），这里不写死任何色值
   ============================================================ */

.page {
  position: relative;
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.body {
  position: relative;
  z-index: 1;
  padding-top: 24rpx;
}

/* ---------------- 学校卡 ---------------- */
.school {
  display: flex;
  align-items: center;
  margin: 0 32rpx;
  height: 124rpx;
  padding: 0 28rpx;
  border-radius: var(--r-md);
}

.logo {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  margin-right: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 校徽底色 = 该校品牌色，换校自动变 */
  background: radial-gradient(circle at 32% 26%,
    var(--brand-soft) 0%, var(--brand) 46%, var(--brand-deep) 100%);
  box-shadow:
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.30),
    0 0 32rpx 4rpx var(--logo-glow);
}

.logo-img {
  width: 56rpx;
  height: 56rpx;
}

.logo-mark {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
}

.meta {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2.4rpx;
  line-height: 1.3;
}

.motto {
  font-size: 21rpx;
  letter-spacing: 3.2rpx;
  color: var(--ink-3);
  margin-top: 2rpx;
}

.streak {
  flex: none;
  margin-left: auto;
  display: flex;
  align-items: baseline;
  padding: 12rpx 20rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(253, 224, 71, 0.22), rgba(251, 146, 60, 0.14));
  border: 1rpx solid rgba(253, 224, 71, 0.28);
}

.streak-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #FDE68A;
  font-variant-numeric: tabular-nums;
}

.streak-unit {
  font-size: 19rpx;
  color: rgba(253, 230, 138, 0.70);
  margin-left: 6rpx;
}

/* ---------------- 每日一题 ---------------- */
.hero-wrap {
  position: relative;
  margin: 28rpx 32rpx 0;
}

/* 卡片背后的光晕：颜色跟着校徽走，让玻璃"发亮"而不是一块灰板 */
.hero-glow {
  position: absolute;
  left: 8%;
  right: 8%;
  top: 24rpx;
  bottom: -28rpx;
  border-radius: 80rpx;
  z-index: 0;
  background: var(--glow);
  filter: blur(60rpx);
}

.hero {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  height: 324rpx;
  padding: 34rpx 36rpx;
  border-radius: var(--r-lg);
  background: var(--hero-bg);
}

.hero-top {
  display: flex;
  align-items: center;
}

.tag {
  display: flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--brand-soft);
  background: var(--tag-bg);
  border: 1rpx solid var(--tag-line);
}

.hero-remain {
  margin-left: auto;
  font-size: 21rpx;
  color: var(--ink-4);
  letter-spacing: 0.8rpx;
}

.hero-title {
  margin-top: 22rpx;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  line-height: 1.2;
  background: linear-gradient(180deg, #FFFFFF 0%, var(--brand-soft) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--ink-3);
  letter-spacing: 2.2rpx;
}

.hero-bottom {
  margin-top: auto;
  display: flex;
  align-items: center;
}

.cta {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 40rpx;
  border-radius: 38rpx;
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 1.2rpx;
  color: var(--cta-fg);
  background: linear-gradient(135deg, #FFFFFF 0%, var(--brand-soft) 60%, var(--brand-lt) 100%);
  box-shadow:
    0 12rpx 36rpx -8rpx var(--cta-glow),
    inset 0 1rpx 0 #FFFFFF;
}

.cta-arrow {
  width: 14rpx;
  height: 14rpx;
  margin-left: 12rpx;
  border-top: 3rpx solid var(--cta-fg);
  border-right: 3rpx solid var(--cta-fg);
  transform: rotate(45deg);
  border-radius: 2rpx;
}

.hero-hint {
  margin-left: auto;
  font-size: 20rpx;
  color: var(--ink-4);
  letter-spacing: 1.2rpx;
}

/* ---------------- 学科区 ---------------- */
.sect {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 38rpx 36rpx 0;
}

.sect-title {
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 2.8rpx;
}

.sect-extra {
  font-size: 21rpx;
  color: var(--ink-4);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 20rpx 32rpx 0;
}

.tile {
  width: 333rpx;
  height: 172rpx;
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: var(--r-md);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

/* 图标底色：--chip-N 由主题引擎按校徽色生成，N 就是学科的 index+1 */
.chip {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--chip-1);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.25),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.07);
}

.chip-ico {
  width: 32rpx;
  height: 32rpx;
}

.chip-emoji {
  font-size: 30rpx;
  line-height: 1;
}

.tile-foot {
  display: flex;
  flex-direction: column;
}

.tile-name {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 3.2rpx;
  line-height: 1.2;
}

.tile-cnt {
  margin-top: 4rpx;
  font-size: 19rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
  font-variant-numeric: tabular-nums;
}

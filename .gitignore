# ============================================================
#  .gitignore —— 防止不该上传的文件混进仓库
#  规则：列在这里的文件/目录，git 会完全忽略它们
# ============================================================

# ---------- 操作系统生成的文件 ----------
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
._*

# ---------- 编辑器 / IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace

# ---------- Node.js ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json.bak

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# ---------- 微信小程序构建产物 ----------
miniprogram_npm/
.miniprogram/
project.private.config.json
*.wxss.bak

# ---------- 敏感信息（重点！）----------
.env
.env.*
*.local
*.key
*.pem
*.p12
*.keystore
secrets.json
config.private.*

# ---------- 大体积二进制（避免仓库膨胀）----------
*.zip
*.rar
*.7z
*.apk
*.ipa
*.exe
*.msi
*.dmg
*.iso
*.img
*.tgz

# ---------- 私人照片（防止误传）----------
# 如果以后要放示例图，请用 assets/ 目录并单独放行
private/
photos/
个人/
*.身份证*
*.一寸照*
*.证件*

# ---------- 临时文件 ----------
*.log
*.tmp
*.bak
~$*
